------------------------------------------------------------------
-- RISING WHITE LINE (KILL EFFECT ANIMATION)
------------------------------------------------------------------
local function playKillEffect()
    local whiteLine = Instance.new("Frame")
    whiteLine.Name = "RisingWhiteLine"
    whiteLine.AnchorPoint = Vector2.new(0, 1)
    whiteLine.Position = UDim2.new(0, 0, 1, 0)
    whiteLine.Size = UDim2.new(1, 0, 0, 5)
    whiteLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    whiteLine.BackgroundTransparency = 0
    whiteLine.BorderSizePixel = 0
    whiteLine.Parent = inner

    local lineCorner = Instance.new("UICorner")
    lineCorner.CornerRadius = UDim.new(0, 3)
    lineCorner.Parent = whiteLine

    local moveUpTween = TweenService:Create(
        whiteLine,
        TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Position = UDim2.new(0, 0, 0, 0)
        }
    )

    local fadeOutTween = TweenService:Create(
        whiteLine,
        TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {
            BackgroundTransparency = 1
        }
    )

    moveUpTween:Play()
    task.delay(0.35, function()
        fadeOutTween:Play()
    end)

    fadeOutTween.Completed:Connect(function()
        whiteLine:Destroy()
    end)
end

------------------------------------------------------------------
-- AUTOMATIC KILL DETECTION
------------------------------------------------------------------
task.spawn(function()
    local leaderstats = player:WaitForChild("leaderstats", 5)
    if leaderstats then
        local kills = leaderstats:FindFirstChild("Kills") or leaderstats:FindFirstChild("kills")
        if kills then
            kills.Changed:Connect(function()
                playKillEffect()
            end)
        end
    end
end)

local function trackEnemyKill(targetPlayer)
    targetPlayer.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid")
        humanoid.Died:Connect(function()
            local creatorTag = humanoid:FindFirstChild("creator")
            if creatorTag and creatorTag.Value == player then
                playKillEffect()
            end
        end)
    end)
end

for _, otherPlayer in ipairs(Players:GetPlayers()) do
    if otherPlayer ~= player then
        trackEnemyKill(otherPlayer)
    end
end

Players.PlayerAdded:Connect(function(otherPlayer)
    if otherPlayer ~= player then
        trackEnemyKill(otherPlayer)
    end
end)

