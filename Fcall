        emoteButton,
        TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Size = config.emoteSize }
    )
    
    clickPop:Play()
    clickPop.Completed:Connect(function()
        clickReset:Play()
        isClicking = false
