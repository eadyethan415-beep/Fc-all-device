-- KILL DETECTION
------------------------------------------------------------------

-- Leaderstats Kills listener
task.spawn(function()
	local leaderstats = player:WaitForChild("leaderstats", 5)
	if leaderstats then
		local kills = leaderstats:FindFirstChild("Kills")
			or leaderstats:FindFirstChild("kills")

		if kills then
			local previousKills = kills.Value
			kills.Changed:Connect(function(newValue)
				if newValue > previousKills then
					for _ = 1, newValue - previousKills do
						addKillChunk()
					end
				end
				previousKills = newValue
			end)
		end
	end
end)

-- Workspace humanoids
local trackedHumanoids = {}

local function trackHumanoid(model)
	if not model:IsA("Model") or model == player.Character then
		return
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or trackedHumanoids[humanoid] then
		return
	end

	trackedHumanoids[humanoid] = true

	humanoid.Died:Connect(function()
		local creatorTag = humanoid:FindFirstChild("creator")
		local modelName = model.Name:lower()

		local isNamedNPC = string.find(modelName, "clone")
			or string.find(modelName, "dummy")
			or model:FindFirstChild("IsClone")

		if (creatorTag and creatorTag.Value == player) or isNamedNPC then
			addKillChunk()
		end
	end)
end

for _, obj in ipairs(workspace:GetDescendants()) do
	if obj:IsA("Model") then
		trackHumanoid(obj)
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") then
		task.delay(0.1, function()
			if obj.Parent then
				trackHumanoid(obj)
			end
		end)
	end
end)

