------------------------------------------------------------------
-- LEVEL UP & PROGRESS SYSTEM
------------------------------------------------------------------

local currentKills = 0
local maxKills = 5
local levelingUp = false

local levelUpLabel = Instance.new("TextLabel")
levelUpLabel.Name = "LevelUpLabel"
levelUpLabel.AnchorPoint = Vector2.new(0.5, 0.5)
levelUpLabel.Position = UDim2.new(0.5, 0, 0.3, 0)
levelUpLabel.Size = UDim2.new(0, 300, 0, 60)
levelUpLabel.BackgroundTransparency = 1
levelUpLabel.Text = "LEVEL UP!"
levelUpLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
levelUpLabel.TextScaled = true
levelUpLabel.Font = Enum.Font.GothamBlack
levelUpLabel.Visible = false
levelUpLabel.Parent = gui

local levelStroke = Instance.new("UIStroke")
levelStroke.Color = Color3.fromRGB(80, 50, 0)
levelStroke.Thickness = 3
levelStroke.Parent = levelUpLabel

local function playLevelUpAnimation()
	levelUpLabel.Visible = true
	levelUpLabel.TextTransparency = 0
	levelUpLabel.Position = UDim2.new(0.5, 0, 0.35, 0)
	levelUpLabel.Size = UDim2.new(0, 100, 0, 20)

	local popTween = TweenService:Create(
		levelUpLabel,
		TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{
			Position = UDim2.new(0.5, 0, 0.28, 0),
			Size = UDim2.new(0, 320, 0, 70)
		}
	)
	popTween:Play()

	task.delay(1.2, function()
		local fadeTween = TweenService:Create(
			levelUpLabel,
			TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				TextTransparency = 1,
				Position = UDim2.new(0.5, 0, 0.22, 0)
			}
		)
		fadeTween:Play()
		fadeTween.Completed:Wait()
		levelUpLabel.Visible = false
	end)
end

local function addKillChunk()
	if levelingUp then return end

	currentKills = math.min(currentKills + 1, maxKills)
	local targetScale = currentKills / maxKills

	TweenService:Create(
		fillFrame,
		TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{Size = UDim2.new(1, 0, targetScale, 0)}
	):Play()

	if currentKills >= maxKills then
		levelingUp = true

		task.delay(0.4, function()
			playLevelUpAnimation()

			local flashTween = TweenService:Create(
				fillFrame,
				TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true),
				{BackgroundTransparency = 0.8}
			)
			flashTween:Play()
			flashTween.Completed:Wait()

			currentKills = 0
			fillFrame.BackgroundTransparency = 0
			fillFrame.Size = UDim2.new(1, 0, 0, 0)
			levelingUp = false
		end)
	end
end

_G.AddClimaxKill = addKillChunk

