
-- CRIMINALITY V1.3 - Stylish Animated Title
-- LocalScript in StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local oldGui = playerGui:FindFirstChild("CriminalityTitle")
if oldGui then
	oldGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CriminalityTitle"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = playerGui

local title = Instance.new("TextLabel")
title.Name = "Title"
title.AnchorPoint = Vector2.new(0.5, 0.5)
title.Position = UDim2.new(0.5, 0, 0, 48)
title.Size = UDim2.new(0.9, 0, 0, 60)
title.BackgroundTransparency = 1

title.Text = "CRIMINALITY V1.3"
title.Font = Enum.Font.Arcade
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.TextStrokeTransparency = 0.1
title.TextStrokeColor3 = Color3.fromRGB(130, 0, 0)
title.Rotation = 0
title.Parent = screenGui

local constraint = Instance.new("UITextSizeConstraint")
constraint.MinTextSize = 12
constraint.MaxTextSize = 36
constraint.Parent = title

-- Red glow effect
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 30, 30)
stroke.Thickness = 1
stroke.Transparency = 0.35
stroke.Parent = title

-- Bob up and down
local bobTween = TweenService:Create(
	title,
	TweenInfo.new(
		1.5,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut,
		-1,
		true
	),
	{
		Position = UDim2.new(0.5, 0, 0, 58)
	}
)
bobTween:Play()

-- Slowly rotate left and right
task.spawn(function()
	while title.Parent do
		local left = TweenService:Create(
			title,
			TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{Rotation = -4}
		)
		left:Play()
		left.Completed:Wait()

		if not title.Parent then break end

		local right = TweenService:Create(
			title,
			TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{Rotation = 4}
		)
		right:Play()
		right.Completed:Wait()
	end
end)
